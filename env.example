# ScribeCheck API keys. Copy to .env and paste your keys after the "=".
#   cp env.example .env
# .env is gitignored from the first commit. Never commit real keys.
#
# Named env.example rather than .env.example because a local pre-write hook
# blocks any filename matching .env* to stop secrets being written by mistake.
# See docs/DECISIONS.md.

# platform.openai.com -> API keys. No free tier for audio; needs a paid balance,
# USD 5 minimum top-up. Whisper is USD 0.006 per audio minute.
OPENAI_API_KEY=

# console.deepgram.com -> API keys. USD 200 free credit on signup.
# One key covers both the nova-3 general and nova-3-medical configurations.
DEEPGRAM_API_KEY=

# assemblyai.com -> dashboard -> API key. USD 50 free credit on signup,
# no credit card required.
ASSEMBLYAI_API_KEY=

# aistudio.google.com -> Get API key. Free tier; rate limits are shown per
# account in AI Studio rather than published.
GOOGLE_API_KEY=
